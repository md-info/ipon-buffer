  "components": {
    "schemas": {
      "ApplyInput": {
        "properties": {
          "draft_id": {
            "type": "string",
            "title": "Draft Id"
          },
          "plan": {
            "$ref": "#/components/schemas/PlanInput"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "draft_id",
          "plan"
        ],
        "title": "ApplyInput"
      },
      "BillInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          },
          "label": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Label"
          },
          "amount_minor": {
            "type": "integer",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "title": "Due Date"
          },
          "recurrence": {
            "type": "string",
            "enum": [
              "one_off",
              "monthly"
            ],
            "title": "Recurrence",
            "default": "one_off"
          },
          "included_in_daily": {
            "type": "boolean",
            "title": "Included In Daily",
            "default": false
          },
          "paid": {
            "type": "boolean",
            "title": "Paid",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "amount_minor",
          "due_date"
        ],
        "title": "BillInput"
      },
      "ConsentInput": {
        "properties": {
          "scopes": {
            "items": {
              "type": "string",
              "enum": [
                "transactions:read",
                "balance:read",
                "buffer:transfer",
                "ai:parse"
              ]
            },
            "type": "array",
            "title": "Scopes"
          },
          "days": {
            "type": "integer",
            "enum": [
              30,
              90,
              180
            ],
            "title": "Days",
            "default": 90
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scopes"
        ],
        "title": "ConsentInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ParseInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ParseInput"
      },
      "PlanInput": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Version"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          },
          "routine_daily_minor": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Routine Daily Minor"
          },
          "next_expected_income": {
            "type": "string",
            "format": "date",
            "title": "Next Expected Income"
          },
          "obligations": {
            "items": {
              "$ref": "#/components/schemas/BillInput"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Obligations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "confirmed",
          "routine_daily_minor",
          "next_expected_income",
          "obligations"
        ],
        "title": "PlanInput"
      },
      "TransferInput": {
        "properties": {
          "amount_minor": {
            "type": "integer",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Idempotency Key"
          },
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          },
          "recommendation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount_minor",
          "idempotency_key",
          "confirmed"
        ],
        "title": "TransferInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
